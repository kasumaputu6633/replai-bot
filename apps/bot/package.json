{
  "name": "@replai/bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "predev": "pnpm --filter @replai/core build && pnpm --filter @replai/config build",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch --watch-preserve-output src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@replai/config": "workspace:*",
    "@replai/core": "workspace:*",
    "discord.js": "^14.27.0",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1"
  }
}

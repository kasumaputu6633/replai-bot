NODE_ENV=development
LOG_LEVEL=info

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Mount a Railway Volume at /app/data and use /app/data/afk-guilds.json in production.
AFK_STATE_PATH=data/afk-guilds.json
# Optional MongoDB persistence for conversation evaluation and AFK state.
MONGODB_URI=
MONGODB_DATABASE=replai
# Optional one-time source URI for idempotent migration into MONGODB_URI.
MONGODB_MIGRATION_SOURCE_URI=

# AI
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=
AI_MODEL=grok-4
# Optional public label shown when users ask what model powers the bot.
AI_PUBLIC_MODEL_NAME=
# Optional creativity control (0-2). Leave empty for the provider default.
AI_TEMPERATURE=
BOT_OWNER_NAME=Nando Ganteng
# Comma-separated owner/developer Discord IDs. These users always receive warm replies.
BOT_PRIVILEGED_USER_IDS=268364999389478912
# Optional 9Router-compatible web tools. Leave blank to disable live search/fetch.
WEB_BASE_URL=
WEB_API_KEY=
AI_WEB_SEARCH_MODEL=exa
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_FETCH_MODEL=exa

# API
API_HOST=0.0.0.0
API_PORT=3000
